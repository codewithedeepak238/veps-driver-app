{
  "expo": {
    "name": "VEPS FleetOne",
    "slug": "veps-driver-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vepsdriverapp",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.veps.driver",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/veps-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "VEPS uses your location to record where each trip starts and ends."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VEPS needs access to your photos to attach images to a trip.",
          "cameraPermission": "VEPS needs camera access to capture trip photos and videos."
        }
      ],
      "expo-build-properties",
      "expo-font",
      "expo-video",
      [
        "expo-notifications",
        {
          "color": "#2563eb"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c6ee6bba-7d06-4db7-be77-fc07ffe59eef"
      }
    },
    "owner": "deepak238"
  }
}
