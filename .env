# ─────────────────────────────────────────────────────────────────────────────
# Driver app → backend API URL
# ─────────────────────────────────────────────────────────────────────────────
# Baked into every build (dev + standalone APK). Points at the deployed backend,
# so the APK works on any network — no Wi-Fi/LAN-IP dependency.
EXPO_PUBLIC_API_URL=https://api.veps-ifleet.com/api/v1
# Other options (uncomment one for local testing; comment the live line above):
# EXPO_PUBLIC_API_URL=https://api.veps-ifleet.com/api/v1
# EXPO_PUBLIC_API_URL=http://10.92.215.14:8000/api/v1
